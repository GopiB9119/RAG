FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata \
    OMP_THREAD_LIMIT=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-azure.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-azure.txt \
    && useradd --create-home --uid 10001 appuser \
    && mkdir -p /data \
    && chown appuser:appuser /data

COPY src/pdf_pipeline/ ./src/pdf_pipeline/
COPY azure_pipeline.py ingest_sources.py rag_core.py index_publication.py embedding_chunks.py ./
USER appuser

CMD ["python", "azure_pipeline.py", "coordinate", "--state-dir", "/data/coordinator", "--database", "/data/chroma"]